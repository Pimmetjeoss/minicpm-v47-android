@@ -0,0 +1,34 @@
+package com.example.minicpm_v_demo
+
+import org.junit.Assert.*
+import org.junit.Test
+
+class ModelInfoTest {
+    @Test fun denseV47UsesItsOwnTwoDownloadFilesAndVersion() {
+        val model = ModelInfo.AVAILABLE_MODELS.single { it.id == "minicpm-v-4_7-1b" }
+        assertEquals("MiniCPM-V-4_7-1B-Q4_K_M.gguf", model.ggufFileName)
+        assertEquals("mmproj-model-f16.gguf", model.mmprojFileName)
+        assertEquals("MiniCPM-V-4.7-1B/${model.ggufFileName}", model.ggufRemotePath)
+        assertEquals("MiniCPM-V-4.7-1B/${model.mmprojFileName}", model.mmprojRemotePath)
+        assertEquals("tc-mb/MiniCPM-V-Apps-gguf", model.hfRepo)
+        assertEquals("zerg13/MiniCPM-V-Apps-gguf", model.msRepo)
+        assertEquals(47, LlamaEngine.inferMinicpmvVersion(model))
+        assertFalse(model.isTextOnly)
+        assertFalse(model.isTts)
+        assertFalse(model.supportsThinking)
+        assertTrue(model.hasHfMsSources)
+        assertNull(model.acousticFileName)
+    }
+
+    @Test fun existingModelsAndDefaultRemainAvailable() {
+        val models = ModelInfo.AVAILABLE_MODELS.associateBy { it.id }
+        assertEquals("minicpm-v-4", ModelInfo.DEFAULT_MODEL.id)
+        assertEquals(5, LlamaEngine.inferMinicpmvVersion(models.getValue("minicpm-v-4")))
+        assertEquals(46, LlamaEngine.inferMinicpmvVersion(models.getValue("minicpm-v-4_6-instruct")))
+        assertTrue(models.getValue("minicpm-v-4_6-instruct").supportsThinking)
+        for (id in listOf("minicpm5-0.9b", "minicpm5-2b", "voxcpm2")) {
+            assertEquals(0, LlamaEngine.inferMinicpmvVersion(models.getValue(id)))
+        }
+        assertEquals(models.size, ModelInfo.AVAILABLE_MODELS.size)
+    }
+}
